[user]
  name = Julian Da Cunha
  email = j.dacunha@pm.me
  #signingkey =

[core]
  editor = nvim
  whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
  excludesfile = ~/.gitignore
  pager = delta

[interactive]
  diffFilter = delta --diff-so-fancy --color-only --features=interactive

[include]
  path = "~/.config/delta/themes/catppuccin.gitconfig"

[delta]
  navigate = true
  side-by-side = true
  line-numbers = true
  features = catppuccin-frappe
  true-color = always

[merge]
  conflictStyle = diff3
  editor = nvim
  whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
  excludesfile = ~/.gitignore
  pager = less -R

[push]
  default = current

[pull]
  rebase = true

[diff]
  colorMoved = default
  rebase = true

[color]
  ui = auto

[color "status"]
  added = green
  changed = yellow
  untracked = blue

[alias]
  loga = log --oneline --graph --color --decorate
  s = status -s -b

[credential]
  helper = store

[gpg]
	program = gpg

[commit]
  gpgsign = true
