  path = zsh/plugins/fast-syntax-highlighting
  url = https://github.com/zdharma-zmirror/fast-syntax-highlighting
[submodule "zsh/plugins/spaceship"]
	path = zsh/plugins/spaceship
	url = https://github.com/spaceship-prompt/spaceship-prompt.git
[submodule "bat/themes/catppuccin"]
	path = bat/themes/catppuccin
	url = https://github.com/catppuccin/bat
[submodule "delta/themes/catppuccin"]
	path = delta/themes/catppuccin
	url = https://github.com/catppuccin/delta
[submodule "k9s/themes/catppuccin"]
	path = k9s/themes/catppuccin
	url = https://github.com/catppuccin/k9s
