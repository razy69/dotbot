# zmodload zsh/zprof

# Zsh Home
export ZSH="${HOME}/.zsh"
export NVIM="${HOME}/.local/share/nvim"

# Settings
source "${ZSH}/config/settings.zsh"

# Keybindings
source "${ZSH}/config/bindings.zsh"

# Prompt
export SPACESHIP_CONFIG="${ZSH}/config/spaceship.zsh"
source "${ZSH}/plugins/spaceship/spaceship.zsh"

# Secrets
[[ ! -f "${ZSH}/config/secrets.zsh" ]] || source "${ZSH}/config/secrets.zsh"

# Path
path=(
  ${HOME}/bin
  ${HOME}/.local/bin
  $path
)
export PATH

# Aliases
source "${ZSH}/config/aliases.zsh"

# Functions
source "${ZSH}/config/functions.zsh"

# mise/fzf activation scripts run a fallback `compinit` while `compdef` is still
# undefined — stub it so the real compinit in config/completions.zsh owns the
# dump; a fallback would write it with system-only fpath and a fresh mtime.
# Calls made against the stub are queued and replayed after real compinit.
_zdefcomp=()
compdef() { _zdefcomp+=("$*") }

# Mise
(( $+commands[mise] )) && eval "$(mise activate zsh)"

# Fzf
(( $+commands[fzf] )) && eval "$(fzf --zsh)"

# Completion
source "${ZSH}/config/completions.zsh"


# Work
[[ ! -f "${ZSH}/config/work.zsh" ]] || source "${ZSH}/config/work.zsh"

# Plugins
source "${ZSH}/config/plugins.zsh"

# Change theme mode
if [[ -n "${TMUX}" ]]; then
  tmux source-file "${HOME}/.tmux.${THEME_MODE}.theme.conf"
fi

alias restish="noglob restish"
# >>> restish completion >>>
# Managed by `restish completion install zsh`.
autoload -Uz compinit
if ! whence -w compdef >/dev/null 2>&1; then
  compinit
fi
if [ -r '/Users/jdacunha/.config/restish/completions/_restish.zsh' ]; then
  source '/Users/jdacunha/.config/restish/completions/_restish.zsh'
fi
# <<< restish completion <<<
