##
# Aliases
##

alias gst="git status"
alias gc="git commit --sign -m"
alias gca="git commit --amend --no-edit"
alias ga="git add"
alias gco="git checkout"
alias gb="git checkout -b"
alias gpf="git push --force-with-lease"
alias gp="git pull --rebase"

alias ccat="bat -p --paging=never"
alias tree="erd"
alias ll="eza -F -m -a -h -l -U -g -u --octal-permissions --git --icons --long"
alias la="eza -R -T -F -m -a -h -l -U -g -u --octal-permissions --git --icons --long"
alias ls="ls --color=auto"
alias restish="restish --rsh-print b"
